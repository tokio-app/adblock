{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.ts",
    "src/scriptlets/runner.ts",
    "src/content/preload.ts",
    "scripts/*/index.ts",
    "scripts/smoke/main.mjs",
    "vitest.config.ts"
  ],
  "ignorePatterns": ["lists/**", "reports/**"],
  "duplicates": {
    "minOccurrences": 2,
    "mode": "strict",
    "ignore": ["**/*.js", "package.json"]
  },
  "rules": {},
  "ignoreDependencies": ["esbuild"]
}
